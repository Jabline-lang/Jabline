// Semantic Versioning - MAJOR.MINOR.PATCH conventions

fn parseVersion(v) {
    let parts = split(v, ".")
    return {
        "major": int(parts[0]),
        "minor": int(parts[1]),
        "patch": int(parts[2])
    }
}

fn isCompatible(required, installed) {
    return required["major"] == installed["major"]
        && required["minor"] <= installed["minor"]
}

let req = parseVersion("2.1.0")
let inst = parseVersion("2.3.1")
print("Compatible: " + toString(isCompatible(req, inst)))
