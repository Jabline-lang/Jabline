// append() adds multiple elements to an array
// Unlike push(), append takes multiple values

let arr = [1, 2, 3]

// Append single element
let result = append(arr, 4)
echo("append one: " + toString(result))

// Append multiple elements
let result2 = append(arr, 4, 5, 6)
echo("append many: " + toString(result2))

// Original array is unchanged
echo("original:    " + toString(arr))
