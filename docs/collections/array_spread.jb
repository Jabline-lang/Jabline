// Spread operator ... expands arrays in-place

let a = [1, 2, 3]
let b = [4, 5, 6]

// Spread in array literals
let combined = [...a, ...b]
echo("combined: " + toString(combined))

// Spread in middle
let result = [0, ...a, 10]
echo("middle:   " + toString(result))

// Spread in function calls
let sum3 = fn(x, y, z) { x + y + z }
let nums = [10, 20, 30]
echo("spread call: " + toString(sum3(...nums)))
