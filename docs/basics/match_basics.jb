// Match Expression - Pattern matching

let value = 42

let description = match value {
    0 { "zero" }
    1 { "one" }
    42 { "the answer" }
    _ { "something else" }
}

print(description)

// Match on strings
let color = "red"
let hex = match color {
    "red"   { "#FF0000" }
    "green" { "#00FF00" }
    "blue"  { "#0000FF" }
    _       { "#000000" }
}
print(color + " -> " + hex)
