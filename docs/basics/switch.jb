// Switch/Case - Multi-way branching

let day = 3

switch day {
    case 1 {
        print("Monday")
    }
    case 2 {
        print("Tuesday")
    }
    case 3 {
        print("Wednesday")
    }
    case 4 {
        print("Thursday")
    }
    case 5 {
        print("Friday")
    }
    default {
        print("Weekend")
    }
}
