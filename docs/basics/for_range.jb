// For Range - Iterate over numeric ranges

print("0 to 4:")
for i in range(5) {
    print("  i = " + toString(i))
}

print("2 to 6:")
for i in range(2, 7) {
    print("  i = " + toString(i))
}

// Sum of 1 to 100
let total = 0
for i in range(1, 101) {
    total = total + i
}
print("Sum 1-100: " + toString(total))
