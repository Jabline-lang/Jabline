// Bitwise - &, |, ^, <<, >> operators

let a = 5   // 0101
let b = 3   // 0011

print("a = " + toString(a) + ", b = " + toString(b))
print("a & b  = " + toString(a & b))    // 0001 = 1
print("a | b  = " + toString(a | b))    // 0111 = 7
print("a ^ b  = " + toString(a ^ b))    // 0110 = 6
print("a << 1 = " + toString(a << 1))   // 1010 = 10
print("a >> 1 = " + toString(a >> 1))   // 0010 = 2
