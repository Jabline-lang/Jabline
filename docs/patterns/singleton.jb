// Singleton - Ensures only one instance exists

let _instance = null

fn getInstance() {
    if (_instance == null) {
        _instance = {
            "config": {"host": "localhost", "port": 8080},
            "getConfig": fn(self) { return self["config"] }
        }
    }
    return _instance
}

let a = getInstance()
let b = getInstance()
assertEqual(a, b, "same instance returned")
print("Singleton config: " + a["config"]["host"])
