// Strategy - Selects algorithm at runtime

fn bubbleSort(arr) {
    let n = len(arr)
    let i = 0
    while (i < n) {
        let j = 0
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}

fn quickSort(arr) {
    if (len(arr) <= 1) { return arr }
    let pivot = arr[0]
    let left = []
    let right = []
    let i = 1
    while (i < len(arr)) {
        if (arr[i] < pivot) {
            left = push(left, arr[i])
        } else {
            right = push(right, arr[i])
        }
        i = i + 1
    }
    return [...quickSort(left), pivot, ...quickSort(right)]
}

fn sortWith(strategy, data) {
    return strategy(data)
}

let data = [3, 1, 4, 1, 5]
let sorted = sortWith(quickSort, data)
print("Sorted: " + stringify(sorted))
