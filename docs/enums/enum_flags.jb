// Bit flag enums using powers of 2

enum Permission {
    None    = 0,
    Read    = 1,
    Write   = 2,
    Execute = 4,
    Delete  = 8,
    Admin   = 16
}

fn hasPermission(userPerms, required) {
    return (userPerms & required) == required
}

let userPerms = Permission.Read | Permission.Write
echo("user perms: " + toString(userPerms))
echo("can read?   " + toString(hasPermission(userPerms, Permission.Read)))
echo("can delete? " + toString(hasPermission(userPerms, Permission.Delete)))
