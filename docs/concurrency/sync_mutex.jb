// Mutex/sync patterns - synchronize access to shared state
// Run with: jabline run sync_mutex.jb

let counter = 0
let ch = channel(10)

fn increment() {
    let local = counter
    local = local + 1
    counter = local
}

let i = 0
while (i < 10) {
    spawn fn() {
        increment()
        ch <- 1
    }()
    i = i + 1
}

let done = 0
while (done < 10) {
    <-ch
    done = done + 1
}

echo("counter: " + toString(counter))
echo("expected: 10 (may differ without mutex)")
