// Worker pool pattern - distribute work across multiple workers
// Run with: jabline run worker_pool.jb

fn worker(id, jobs, results) {
    for (job in jobs) {
        let result = job * 2
        results <- "worker " + toString(id) + " processed " + toString(job) + " -> " + toString(result)
    }
}

let numJobs = 6
let numWorkers = 3
let jobs = channel(numJobs)
let results = channel(numJobs)

let w = 0
while (w < numWorkers) {
    spawn worker(w, jobs, results)
    w = w + 1
}

let j = 0
while (j < numJobs) {
    jobs <- j
    j = j + 1
}
close(jobs)

let done = 0
while (done < numJobs) {
    echo(<-results)
    done = done + 1
}
close(results)
