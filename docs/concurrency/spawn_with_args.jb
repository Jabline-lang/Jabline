// Spawning with arguments - pass data to spawned functions
// Run with: jabline run spawn_with_args.jb

fn worker(id, count, ch) {
    let i = 0
    while (i < count) {
        ch <- "worker " + toString(id) + ": " + toString(i)
        i = i + 1
    }
}

let ch = channel(10)
spawn worker(1, 3, ch)
spawn worker(2, 4, ch)
spawn worker(3, 2, ch)

sleep(100)
let received = []
let val = <-ch
while (val != null) {
    received = push(received, val)
    val = <-ch
}

echo("received " + toString(len(received)) + " messages")
