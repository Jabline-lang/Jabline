// Type constraints on generic parameters

interface HasName {
    Name(): string
}

struct Person {
    name: string
}

fn (p Person) Name(): string {
    return p.name
}

struct Pet {
    name: string
}

fn (p Pet) Name(): string {
    return p.name
}

fn greet<T>(item: T) {
    match (item) {
        case HasName:
            echo("Hello, " + item.Name() + "!")
        default:
            echo("Hello, unknown!")
    }
}

greet(Person { name: "Alice" })
greet(Pet { name: "Rex" })
greet(42)
