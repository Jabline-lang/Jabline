// server.jb - demonstrates basic HTTP server

import http

fn handler(req) {
    return {
        "status": 200,
        "headers": {"Content-Type": "text/plain"},
        "body": "Hello from Jabline server!"
    }
}

fn main() {
    http.serve(":8080", handler)
    println("Server running on http://localhost:8080")
}
