// parse_csv.jb - demonstrates parsing CSV strings

import csv

let raw = "id,name,score\n1,Alice,95.5\n2,Bob,87.0\n3,Carol,92.3"

fn main() {
    let data = csv.parse(raw)
    println("Parsed " + len(data) + " rows")

    for row in data {
        println("ID: " + row[0] + ", Name: " + row[1] + ", Score: " + row[2])
    }
}
