// Property Testing - Testing invariants and properties

fn reverse(arr) {
    let result = []
    let i = len(arr) - 1
    while (i >= 0) {
        result = push(result, arr[i])
        i = i - 1
    }
    return result
}

fn isPalindrome(arr) {
    let rev = reverse(arr)
    let i = 0
    while (i < len(arr)) {
        if (arr[i] != rev[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

describe("Properties", fn() {
    it("reverse(reverse(x)) == x", fn() {
        let original = [1, 2, 3, 4]
        let result = reverse(reverse(original))
        let i = 0
        while (i < len(original)) {
            assertEqual(result[i], original[i], "element " + toString(i))
            i = i + 1
        }
    })
})
