// Currying - Transforming multi-arg functions into chained single-arg calls

fn add(a) {
    return fn(b) {
        return a + b
    }
}

fn multiply(a) {
    return fn(b) {
        return a * b
    }
}

let add5 = add(5)
let double = multiply(2)

print("add(3)(4) = " + toString(add(3)(4)))
print("add5(10) = " + toString(add5(10)))
print("double(7) = " + toString(double(7)))
print("add5(double(3)) = " + toString(add5(double(3))))
