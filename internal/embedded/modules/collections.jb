// =============================================================
// Jabline Standard Generic Collections
// collections.jb — Stack, Queue, Option, Result, Pair
// =============================================================
// Jabline usa Type Erasure para genéricos: los tipos se validan
// en tiempo de ejecución usando el campo "__type".

// ────────────────────────────────────────────────────────────
// Stack[T] — Pila LIFO genérica
// ────────────────────────────────────────────────────────────
export fn Stack() {
    let state = { "data": [] };

    return {
        "push": fn(self, item) {
            state["data"] = push(state["data"], item);
            return self;
        },
        "pop": fn(self) {
            if (len(state["data"]) == 0) { return null; }
            let item = last(state["data"]);
            let n = len(state["data"]);
            let newData = [];
            let i = 0;
            while (i < n - 1) {
                newData = push(newData, state["data"][i]);
                i = i + 1;
            }
            state["data"] = newData;
            return item;
        },
        "peek": fn(self) {
            if (len(state["data"]) == 0) { return null; }
            return last(state["data"]);
        },
        "size": fn(self) {
            return len(state["data"]);
        },
        "isEmpty": fn(self) {
            return len(state["data"]) == 0;
        },
        "toArray": fn(self) {
            return state["data"];
        }
    };
}

// ────────────────────────────────────────────────────────────
// Queue[T] — Cola FIFO genérica
// ────────────────────────────────────────────────────────────
export fn Queue() {
    let state = { "data": [] };

    return {
        "enqueue": fn(self, item) {
            state["data"] = push(state["data"], item);
            return self;
        },
        "dequeue": fn(self) {
            if (len(state["data"]) == 0) { return null; }
            let item = first(state["data"]);
            state["data"] = rest(state["data"]);
            return item;
        },
        "peek": fn(self) {
            if (len(state["data"]) == 0) { return null; }
            return first(state["data"]);
        },
        "size": fn(self) {
            return len(state["data"]);
        },
        "isEmpty": fn(self) {
            return len(state["data"]) == 0;
        },
        "toArray": fn(self) {
            return state["data"];
        }
    };
}


// ────────────────────────────────────────────────────────────
// Option[T] — Tipo opcional (Some/None) evita null pointer
// ────────────────────────────────────────────────────────────
export fn Some(value) {
    return {
        "isSome": true,
        "isNone": false,
        "value": value,
        "unwrap": fn(self) {
            return value;
        },
        "unwrapOr": fn(self, fallback) {
            return value;
        },
        "map": fn(self, f) {
            return Some(f(value));
        }
    };
}

export fn None() {
    return {
        "isSome": false,
        "isNone": true,
        "value": null,
        "unwrap": fn(self) {
            throw "Attempted to unwrap a None value";
        },
        "unwrapOr": fn(self, fallback) {
            return fallback;
        },
        "map": fn(self, f) {
            return None();
        }
    };
}

// ────────────────────────────────────────────────────────────
// Result[T, E] — Éxito o error tipado
// ────────────────────────────────────────────────────────────
export fn Ok(value) {
    return {
        "isOk": true,
        "isErr": false,
        "value": value,
        "error": null,
        "unwrap": fn(self) {
            return value;
        },
        "unwrapErr": fn(self) {
            throw "Attempted to unwrapErr on Ok value";
        },
        "map": fn(self, f) {
            return Ok(f(value));
        },
        "mapErr": fn(self, f) {
            return self;
        }
    };
}

export fn Err(error) {
    return {
        "isOk": false,
        "isErr": true,
        "value": null,
        "error": error,
        "unwrap": fn(self) {
            throw "Attempted to unwrap Err: " + error;
        },
        "unwrapErr": fn(self) {
            return error;
        },
        "map": fn(self, f) {
            return self;
        },
        "mapErr": fn(self, f) {
            return Err(f(error));
        }
    };
}

// ────────────────────────────────────────────────────────────
// Pair[A, B] — Tupla de dos valores
// ────────────────────────────────────────────────────────────
export fn Pair(first, second) {
    return {
        "first": first,
        "second": second,
        "swap": fn(self) {
            return Pair(second, first);
        },
        "map": fn(self, f) {
            return Pair(f(first), f(second));
        }
    };
}

// ────────────────────────────────────────────────────────────
// Generic higher-order functions (map, filter, reduce)
// ────────────────────────────────────────────────────────────
export fn gmap(arr, f) {
    let result = [];
    for (item in arr) {
        result = push(result, f(item));
    }
    return result;
}

export fn gfilter(arr, predicate) {
    let result = [];
    for (item in arr) {
        if (predicate(item)) {
            result = push(result, item);
        }
    }
    return result;
}

export fn greduce(arr, initial, f) {
    let acc = initial;
    for (item in arr) {
        acc = f(acc, item);
    }
    return acc;
}

export fn gzip(arr1, arr2) {
    let result = [];
    let len1 = len(arr1);
    let len2 = len(arr2);
    let minLen = len1;
    if (len2 < len1) { minLen = len2; }
    let i = 0;
    while (i < minLen) {
        result = push(result, Pair(arr1[i], arr2[i]));
        i = i + 1;
    }
    return result;
}

export fn gflatten(arr) {
    let result = [];
    for (item in arr) {
        for (inner in item) {
            result = push(result, inner);
        }
    }
    return result;
}
