{
    "name": "jabline-lang",
    "displayName": "Jabline Language Support",
    "description": "Full language support for Jabline (.jb) — syntax highlighting, IntelliSense, hover, go-to-definition, formatting and more via the built-in LSP server.",
    "version": "0.6.0",
    "publisher": "Jabline",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:jabline"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "jabline",
                "aliases": [
                    "Jabline",
                    "jabline"
                ],
                "extensions": [
                    ".jb"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "jabline",
                "scopeName": "source.jabline",
                "path": "./syntaxes/jabline.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Jabline",
            "properties": {
                "jabline.executablePath": {
                    "type": "string",
                    "default": "jabline",
                    "description": "Path to the jabline executable. Defaults to 'jabline' (must be in PATH)."
                },
                "jabline.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Trace communication between VS Code and the Jabline LSP server."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.75.0"
    }
}
