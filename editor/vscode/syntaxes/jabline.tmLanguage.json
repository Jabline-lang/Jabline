{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Jabline",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.jabline",
                    "match": "//.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jabline",
                    "match": "\\b(if|else|return|for|while|break|continue|panic)\\b"
                },
                {
                    "name": "storage.type.jabline",
                    "match": "\\b(let|fn)\\b"
                },
                {
                    "name": "keyword.control.module.jabline",
                    "match": "\\b(import|export|from)\\b"
                },
                {
                    "name": "constant.language.jabline",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jabline",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.jabline",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.function.jabline",
                    "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.function.jabline"
                        },
                        "2": {
                            "name": "entity.name.function.jabline"
                        }
                    },
                    "end": "\\)",
                    "patterns": [
                        {
                            "name": "variable.parameter.jabline",
                            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                        }
                    ]
                },
                {
                    "name": "support.function.builtin.jabline",
                    "match": "\\b(push|len|type|echo|split|keys|values|is_error|Error|parse|stringify|http_serve|db_open|db_all|db_get|db_run|db_insert|path_segments|path_param)\\b(?=\\s*\\()"
                },
                {
                    "name": "entity.name.function.call.jabline",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.jabline",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.jabline",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.jabline",
                    "match": "==|!=|<=|>=|<|>|\\+|-|\\*|/|="
                }
            ]
        }
    },
    "scopeName": "source.jabline"
}
