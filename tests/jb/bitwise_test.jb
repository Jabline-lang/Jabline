describe(
    "Bitwise Operations",
    fn() {
        it(
            "supports bitwise AND",
            fn() {
                assertEqual(1 & 3, 1, "AND");
                assertEqual(5 & 3, 1, "AND 5&3");
                assertEqual(0 & 1, 0, "AND with 0");
            }
        )

        it(
            "supports bitwise OR",
            fn() {
                assertEqual(1 | 2, 3, "OR 1|2");
                assertEqual(4 | 2, 6, "OR 4|2");
                assertEqual(0 | 1, 1, "OR with 0");
            }
        )

        it(
            "supports bitwise XOR",
            fn() {
                assertEqual(1 ^ 3, 2, "XOR 1^3");
                assertEqual(5 ^ 3, 6, "XOR 5^3");
            }
        )

        it(
            "supports bitwise left shift",
            fn() {
                assertEqual(1 << 2, 4, "left shift");
                assertEqual(3 << 1, 6, "left shift 3");
            }
        )

        it(
            "supports bitwise right shift",
            fn() {
                assertEqual(8 >> 2, 2, "right shift");
                assertEqual(6 >> 1, 3, "right shift 6");
            }
        )

        it(
            "supports combined bitwise operations",
            fn() {
                let a = 3;
                let b = 5;
                assertEqual(a & b, 1, "combined AND");
                assertEqual(a | b, 7, "combined OR");
                assertEqual(a ^ b, 6, "combined XOR");
            }
        )
    }
)
